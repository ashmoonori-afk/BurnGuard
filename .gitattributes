# Force LF for shell scripts so macOS / Linux can execute them
# regardless of the developer's core.autocrlf setting.
*.command text eol=lf
*.sh      text eol=lf

# Keep native source and workflows stable for exact-text contract tests.
*.swift text eol=lf
.github/workflows/*.yml text eol=lf

# Keep Windows scripts as CRLF for cmd.exe compatibility.
*.bat text eol=crlf
*.cmd text eol=crlf

# Preserve frozen corpus bytes for raw SHA-256 verification on every platform.
packages/backend/tests/fixtures/theme-engine/** -text

# Generated palette hashes must survive Windows checkout unchanged.
"design system themes/*/palette/state.json" text eol=lf
"design system themes/*/palette/scales.css" text eol=lf
